    "def _extract_tome_group_key(df: pd.DataFrame) -> pd.Series:\n",
    "    \"\"\"\n",
    "    Derive a sort/group key from config_name, handling three formats:\n",
    "\n",
    "      1. \"… r=8 …\"              → \"r=8\"\n",
    "      2. \"… keep=[0.70,0.70]\"   → \"keep=[0.70,0.70,0.70]\"   (full bracket string)\n",
    "      3. anything else           → config_name with model_id prefix stripped\n",
    "\n",
    "    The returned series has one string per row and is used as the x-axis\n",
    "    grouping key in both single- and multi-model bar charts.\n",
    "    \"\"\"\n",
    "    keys = []\n",
    "    for _, row in df.iterrows():\n",
    "        name = str(row[\"config_name\"])\n",
    "        model = str(row.get(\"model_id\", \"\"))\n",
    "\n",
    "        # Format 1: r=<int>\n",
    "        m = pd.Series([name]).str.extract(r\"\\br=(\\d+)\\b\")[0][0]\n",
    "        if pd.notna(m):\n",
    "            keys.append(f\"r={m}\")\n",
    "            continue\n",
    "\n",
    "        # Format 2: keep=[...]\n",
    "        m2 = pd.Series([name]).str.extract(r\"(keep=\\[[^\\]]+\\])\")[0][0]\n",
    "        if pd.notna(m2):\n",
    "            keys.append(m2)\n",
    "            continue\n",
    "\n",
    "        # Format 3: strip model_id prefix and use the remainder\n",
    "        stripped = name.replace(model, \"\").strip(\" _-|\")\n",
    "        keys.append(stripped if stripped else name)\n",
    "\n",
    "    return pd.Series(keys, index=df.index)\n",
    "\n",
    "\n",
    "def _shorten_tome_labels(group_keys: list) -> list:\n",
    "    \"\"\"\n",
    "    Produce compact x-tick labels from group keys.\n",
    "\n",
    "    \"r=8\"                          → \"r=8\"\n",
    "    \"keep=[0.70,0.70,0.70]\"        → \"[.70×3]\"   (all equal)\n",
    "    \"keep=[0.90,0.70,0.50]\"        → \"[.90,.70,.50]\"\n",
    "    anything else                  → truncated to 14 chars\n",
    "    \"\"\"\n",
    "    labels = []\n",
    "    for key in group_keys:\n",
    "        # Already short r= form\n",
    "        if key.startswith(\"r=\"):\n",
    "            labels.append(key)\n",
    "            continue\n",
    "\n",
    "        # keep=[...] form\n",
    "        inner_match = pd.Series([key]).str.extract(r\"keep=\\[([^\\]]+)\\]\")[0][0]\n",
    "        if pd.notna(inner_match):\n",
    "            vals = [v.strip() for v in inner_match.split(\",\")]\n",
    "            # Drop leading zero for compactness: 0.70 → .70\n",
    "            short_vals = [v.lstrip(\"0\") if v.startswith(\"0.\") else v for v in vals]\n",
    "            unique_vals = list(dict.fromkeys(short_vals))\n",
    "            if len(unique_vals) == 1:\n",
    "                labels.append(f\"[{unique_vals[0]}×{len(short_vals)}]\")\n",
    "            else:\n",
    "                labels.append(\"[\" + \",\".join(short_vals) + \"]\")\n",
    "            continue\n",
    "\n",
    "        # Fallback: truncate\n",
    "        labels.append(key[:14] + \"…\" if len(key) > 14 else key)\n",
    "\n",
    "    return labels\n",
    "\n"
   ]
  },
