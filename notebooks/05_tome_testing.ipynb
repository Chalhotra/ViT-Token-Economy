    "# Final ToMe visualization call (works with any subset of models/keep-rates already run)\n",
    "if 'results' not in globals() or not results:\n",
    "    print('No results found. Run any ToMe sweep cells first.')\n",
    "else:\n",
    "    df_all = pd.DataFrame(results).copy()\n",
    "    df_tome = df_all[df_all['config_name'].astype(str).str.startswith('ToMe ')].copy()\n",
    "\n",
    "    if df_tome.empty:\n",
    "        print('No ToMe results found yet.')\n",
    "    else:\n",
    "        extracted = df_tome['config_name'].str.extract(\n",
    "            r'^ToMe\\s+(?P<parsed_model>\\S+)\\s+keep=\\[(?P<keep_rate>\\d+\\.\\d+),'\n",
    "        )\n",
    "        df_tome['model_id'] = df_tome.get('model', extracted['parsed_model'])\n",
    "        df_tome['model_id'] = df_tome['model_id'].fillna(extracted['parsed_model'])\n",
    "        df_tome['keep_rate'] = pd.to_numeric(extracted['keep_rate'], errors='coerce')\n",
    "\n",
    "        for col in ['acc1', 'gflops', 'latency_ms', 'throughput', 'params_m']:\n",
    "            if col in df_tome.columns:\n",
    "                df_tome[col] = pd.to_numeric(df_tome[col], errors='coerce')\n",
    "\n",
    "        # Keep only rows that can be plotted numerically (placeholder 0.25 rows are dropped automatically).\n",
    "        plot_df = df_tome.dropna(subset=['acc1', 'gflops', 'latency_ms']).copy()\n",
    "        if plot_df.empty:\n",
    "            print('No numeric ToMe results available to plot yet.')\n",
    "        else:\n",
    "            compare_tome_configurations_spacious(\n",
    "                plot_df.to_dict(orient='records'),\n",
    "                title=f'ToMe Multi-Model Keep-Rate Comparison (Available Runs: {len(plot_df)})'\n",
    "            )"
   ]
